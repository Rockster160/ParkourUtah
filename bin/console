#!/usr/bin/env bash
set -e

SERVER="deploy@parkourutah.com"
APP_DIR="/home/deploy/parkourutah/current"

echo -e "\033[96m==> Opening production Rails console...\033[0m"

ssh -t $SERVER "export PATH=\"\$HOME/.rbenv/bin:\$HOME/.rbenv/shims:\$PATH\" && eval \"\$(\$HOME/.rbenv/bin/rbenv init - bash)\" && cd $APP_DIR && set -a && source .env && set +a && RAILS_ENV=production bundle exec rails console"
