$('body').prepend('<%= j render "layouts/flashes" %>');
$('.shopping-cart-price-holder').html('<%= j number_to_currency(@cart.subtotal_before_bundle_in_dollars) %>');
$('.shopping-cart-taxes-holder').html('<%= j number_to_currency(@cart.taxes_in_dollars) %>');
$('.shopping-cart-shipping-holder').html('<%= j number_to_currency(@cart.shipping_in_dollars) %>');
$('.shopping-cart-total-holder').html('<%= j number_to_currency(@cart.total_in_dollars) %>');
<%# No data-amount update here: checkout.js reads the script tag's data-* attributes
    once, in the Button constructor at page load, and open() replays that cached
    options object — so writing the attribute afterwards does nothing. It also used
    to write number_to_currency(pennies), which Stripe parseInt's to NaN. Showing
    the real total in the payment modal needs the StripeCheckout.configure
    integration, where the amount is passed at open() time. %>

$('.shopping-cart-line-item-quantity-input').each(function() {
  $(this).val(0);
})
<% @cart.cart_items.each do |order|
     unit_price = order.item.effective_unit_price_for(order.amount, current_user)
     has_discount = unit_price < order.item.cost_in_pennies
     selector = order.order_name.parameterize
%>
  var amount = "<%= order.amount %>";
  $('.value-selector-<%= selector %>').val(amount);
  (function() {
    var $row = $('.value-selector-<%= selector %>').closest('.shopping-cart-line-item');
    var $normal = $row.find('.normal-price');
    var $discount = $row.find('.discount-price');
    <% if has_discount %>
      $normal.addClass('strike');
      if ($discount.length) {
        $discount.text('<%= j number_to_currency(unit_price / 100.0) %>');
      } else {
        $normal.after('<span class="discount-price"><%= j number_to_currency(unit_price / 100.0) %></span>');
      }
    <% else %>
      $normal.removeClass('strike');
      $discount.remove();
    <% end %>
  })();
<% end %>

// Re-render cart-wide discount summary
$('.shopping-cart-discount-summary').html('<%= j render(partial: "store/discount_summary_rows", locals: { cart: @cart }) %>');

<% if @order %>
  $('.orders-placeholder').append('<div class="hidden-holder"><%= j render partial: "shopping_cart_item", locals: {order: @order} %></div>');
  <% message = @order.item.bundle_amount? && @order.item.bundle_cost_in_pennies ? "Hey! If you buy #{@order.item.bundle_amount} or more of these, you get the family discount!" : "" %>
  addFlashNotice('<%= message %>');
<% end %>
<% if @redeemed_token %>
  <% if @invalid %>
    $('.redemption-key-container').val('').attr('placeholder', 'Invalid Code').blur();
  <% else %>
    $('.redemption-key-container').val('').attr('placeholder', 'Coupon Code').blur();
  <% end %>
<% end %>
updateCartItems();
