<%= render_modal("edit_user_plans") do %>
  <h1 class="pkut-text hidden-xs">Plans</h1>
  <h4 class="pkut-text visible-xs">Plans</h4>

  <%# Overdue plans — lapsed but still auto_renew — belong here too. They sit in
      monthly_plan_charges' queue and the card already carries the "Cancel
      auto-renew" action, but filtering on `.active` alone hid them, so the one
      set of plans an admin actually needs to act on was the one set they could
      not reach. %>
  <% shown_plans = (@user.purchased_plan_items.active.to_a + @user.purchased_plan_items.inactive.auto_renew.to_a).sort_by { |p| p.expires_at || Time.current } %>
  <% assigned_plans = shown_plans.select { |p| p.athlete_id.present? } %>
  <% unassigned_plans = shown_plans.select { |p| p.athlete_id.nil? } %>

  <% if shown_plans.empty? %>
    <div class="modal-section">
      <p>This user has no active plans.</p>
    </div>
  <% end %>

  <% if assigned_plans.any? %>
    <div class="modal-section">
      <h3>Assigned</h3>
      <% assigned_plans.each do |plan| %>
        <%= render partial: 'admin_users/plan_card', locals: { plan: plan } %>
      <% end %>
    </div>
  <% end %>

  <% if unassigned_plans.any? %>
    <div class="modal-section">
      <h3>Unassigned</h3>
      <p style="margin-bottom: 0.5em;"><small>Benefits do not apply until the user assigns these to an athlete.</small></p>
      <% unassigned_plans.each do |plan| %>
        <%= render partial: 'admin_users/plan_card', locals: { plan: plan } %>
      <% end %>
    </div>
  <% end %>
<% end %>
