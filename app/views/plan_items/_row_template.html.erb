<% item = (item || {}).with_indifferent_access %>
<% free = type == :free_items %>

<div class="infinite-row plan-row-data">
  <input class="pkut-textbox" type="text" name="plan_item[<%= type %>][][tags]" placeholder="Tags (e.g. classes)" value="<%= item[:tags]&.join(", ") %>">

  <% if free %>
    <input class="pkut-textbox" type="text" name="plan_item[<%= type %>][][count]" placeholder="0 = unlimited" value="<%= item[:count] %>">
    <select class="pkut-textbox" name="plan_item[<%= type %>][][interval]">
      <% options = [:day, :week, :month] %>
      <% selected = options.find { |o| o == item[:interval]&.to_sym } || :week %>
      <% options.each do |opt| %>
        <%= content_tag :option, "per #{opt}", value: opt, selected: selected == opt ? :selected : nil %>
      <% end %>
    </select>
  <% else %>
    <input class="pkut-textbox" type="text" name="plan_item[<%= type %>][][discount]" placeholder="$10 or 10%" value="<%= item[:discount] %>">
  <% end %>

  <span class="remove-row" title="Remove row">&times;</span>
</div>
